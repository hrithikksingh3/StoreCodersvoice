NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster/database
FRONTEND_URL=http://localhost:5173
# In production this must be the public HTTPS URL of the backend, for example https://api.store.codersvoice.me
PUBLIC_API_URL=http://localhost:5000
PUBLIC_SITE_URL=https://codersvoice.me
JWT_SECRET=replace-with-a-long-random-secret
# Use a separate random value of at least 32 characters in production.
DOWNLOAD_TOKEN_SECRET=replace-with-a-different-long-random-secret
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-unique-password
RAZORPAY_KEY=rzp_test_replace_me
RAZORPAY_SECRET=replace_me
# Use a fresh Resend key and a verified sender address/domain.
RESEND_API_KEY=re_replace_me
EMAIL_USER=support@example.com
GEMINI_API_KEY=replace_me
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
